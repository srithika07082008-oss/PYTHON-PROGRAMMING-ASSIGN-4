import os
import tempfile
 
class InvalidRecord(Exception):
    """Raised when an attendance line has an invalid format."""
 
def parse_line(line):
    parts = [part.strip() for part in line.strip().split(",")]
 
    if len(parts) != 3:
        raise InvalidRecord(
            f"expected 3 fields, found {len(parts)}"
        )
 
    reg_no, day, status = parts
    if not reg_no:
        raise InvalidRecord("register number is empty")
    if status not in ("P", "A"):
        raise InvalidRecord(f"invalid status {status!r}")
 
    return reg_no, day, status
 
def summarise(path):
    present = 0
    absent = 0
    errors = []
 
    try:
        with open(path, "r", encoding="utf-8") as file:
            for line_no, line in enumerate(file, start=1):
                if not line.strip():
                    continue
                try:
                    reg_no, day, status = parse_line(line)
                    if status == "P":
                        present += 1
                    else:
                        absent += 1
                except InvalidRecord as exc:
                    errors.append((line_no, str(exc)))
                except ValueError as exc:
                    errors.append((line_no, f"invalid value: {exc}"))
 
    except FileNotFoundError as exc:
        print(f"Missing file: {exc.filename}")
        return 0, 0, [(0, "file not found")]
    except PermissionError as exc:
        print(f"Permission denied: {exc.filename}")
        return 0, 0, [(0, "permission denied")]
    except UnicodeDecodeError as exc:
        print(f"Encoding error: {exc}")
        return 0, 0, [(0, "invalid text encoding")]
    except OSError as exc:
        print(f"File I/O error: {exc}")
        return 0, 0, [(0, str(exc))]
    else:
        # Runs only when the file-processing try block had no file error.
        print("File processed successfully.")
    finally:
        # Runs whether the file succeeds or fails.
        print("Processing attempt finished.")
 
    return present, absent, errors
 
